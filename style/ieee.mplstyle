# IEEE 单栏/双栏插图通用风格：8pt 字体、嵌入字体、无边框冗余
font.family: serif
font.serif: Times New Roman, Nimbus Roman, DejaVu Serif
font.size: 8
axes.labelsize: 8
axes.titlesize: 8
legend.fontsize: 7
xtick.labelsize: 7
ytick.labelsize: 7
lines.linewidth: 1.2
lines.markersize: 4
axes.linewidth: 0.8
axes.grid: true
grid.linewidth: 0.4
grid.alpha: 0.35
legend.frameon: false
figure.dpi: 300
savefig.dpi: 300
savefig.bbox: tight
savefig.pad_inches: 0.02
pdf.fonttype: 42
ps.fonttype: 42
